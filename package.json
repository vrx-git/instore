{
  "name": "stock-register",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client",
    "instore"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server",
    "dev:instore": "npm run dev -w instore",
    "build:instore": "npm run build -w instore",
    "test:instore": "npm run test -w instore"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
